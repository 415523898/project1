{
  "name": "dsh-forest-lab-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check build-only",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "preview": "vite preview",
    "format:check": "prettier --check --ignore-path ../.prettierignore src vite.config.ts *.json",
    "lint": "eslint src vite.config.ts ../eslint.config.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "katex": "0.19.0",
    "pinia": "^4.0.3",
    "vue": "3.5.43",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "npm-run-all2": "^9.0.2",
    "prettier": "3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.12"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
