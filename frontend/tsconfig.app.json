{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
  "compilerOptions": {
    "tsBuildInfoFile": "../.local/cache/tsconfig.app.tsbuildinfo",
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
